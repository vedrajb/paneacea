<Window x:Class="Paneacea.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Paneacea" Width="1200" Height="760" MinWidth="720" MinHeight="420" WindowStyle="None" ResizeMode="CanResize" KeyboardNavigation.TabNavigation="None" KeyboardNavigation.ControlTabNavigation="None" Background="{DynamicResource EditorBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <DockPanel>
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource StatusBarBackgroundBrush}" Padding="10,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" VerticalAlignment="Center" Text="Connecting to runtime…" FontSize="12"/>
        <TextBlock x:Name="RuntimeState" Grid.Column="1" VerticalAlignment="Center" Text="Runtime · Connected" FontSize="12"/>
      </Grid>
    </Border>

    <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="46" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock Text="Paneacea" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
          <TextBlock Text="  TERMINAL WORKSPACE" FontSize="11" VerticalAlignment="Center" Margin="12,2,0,0" Foreground="{DynamicResource MutedForegroundBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="+ New Tab" Click="NewTab_Click" ToolTip="Terminal: New Tab"/>
          <Button Content="Split Right" Click="SplitRight_Click" ToolTip="Terminal: Split Right"/>
          <Button Content="Split Down" Click="SplitDown_Click" ToolTip="Terminal: Split Down"/>
          <Button Content="Command Palette" Click="Commands_Click" ToolTip="Paneacea: Open Command Palette"/>
          <Button x:Name="MinimizeWindowButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Click="MinimizeWindow_Click" ToolTip="Minimize" Width="34" Padding="0" FontSize="12" Background="Transparent" BorderThickness="0"/>
          <Button x:Name="MaximizeWindowButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Click="MaximizeWindow_Click" ToolTip="Maximize" Width="34" Padding="0" FontSize="12" Background="Transparent" BorderThickness="0"/>
          <Button x:Name="CloseWindowButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Click="CloseWindow_Click" ToolTip="Close" Width="34" Padding="0" FontSize="12" Background="Transparent" BorderThickness="0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource ActivityBarBackgroundBrush}">
        <StackPanel VerticalAlignment="Top">
          <Button Content="EX" ToolTip="Explorer" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" Padding="4,12"/>
          <Button Content="⌘" Click="Commands_Click" ToolTip="Command Palette" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="18" Padding="4,10"/>
          <Separator Background="{DynamicResource BorderBrush}" Margin="10,6"/>
          <Button Content="+" Click="NewTab_Click" ToolTip="Terminal: New Tab" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="20" Padding="4,8"/>
          <Button x:Name="SettingsButton" Content="⚙" Click="Settings_Click" ToolTip="Settings" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="17" Padding="4,10"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="12,14,12,8">
            <TextBlock Text="EXPLORER" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,10"/>
            <Button Content="Open Folder" Click="NewWorkspace_Click" HorizontalContentAlignment="Left" ToolTip="Workspace: Open Folder"/>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
            <TextBlock Text="Select a workspace to view its terminal tabs and panes." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
          </Border>
          <ListBox x:Name="WorkspaceList" SelectionChanged="WorkspaceList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <StackPanel.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                      <MenuItem Header="Rename workspace" Click="RenameWorkspaceContextMenu_Click"/>
                      <MenuItem Header="Close workspace" Click="CloseWorkspaceContextMenu_Click"/>
                    </ContextMenu>
                  </StackPanel.ContextMenu>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding RootDirectory}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="2" Background="{DynamicResource EditorBackgroundBrush}">
        <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
          </ScrollViewer>
        </Border>
        <ContentControl x:Name="PaneHost"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
